section("tgd/solutions: solution generator")$
HGs : H_metric()$
HJs : H_kahler()$
/* the report reproduces the classification of known surfaces */
repM : extremal_report(emb_setup(HGs, H_X, [tt, xx, yy, zz, 0, 0, 0, 0], [tt, xx, yy, zz]), HJs)$
check("report: canonical M^4 is a vacuum extremal", report_is(repM, true, true, true))$
xiCs : [tt, zz, aa, bb]$
repC : extremal_report(emb_setup(HGs, H_X, [tt, 0, 0, zz, aa, bb, 0, 0], xiCs), HJs)$
check("report: cosmic string has J # 0, both parts vanish", report_is(repC, false, true, true))$
rep_holo(z1, z2) := extremal_report(emb_setup(HGs, H_X, holo_surface(lc_m4, z1, z2), lc_chart), HJs)$
check("report: z1 = w/2 is minimal, Kahler part does not vanish",
      report_is(rep_holo(lc_w/2, 0), false, false, true))$
/* Pitkanen's criterion (About Twistor Lift of TGD, 4.3): A = J^a_c J^{cb} H^k_ab = 0 and
   j = 0 or light-like.  On z1 = w/2 the first holds and the second does not. */
emH : emb_setup(HGs, H_X, holo_surface(lc_m4, lc_w/2, 0), lc_chart)$
JH : induced_kahler_form(HJs, H_X, emb_get(emH, 'h), lc_chart)$
giH : emb_get(emH, 'gi)$
BH : second_fundamental_form(emH)$
MH : tgd_msimp(giH . JH . giH . JH . giH)$
AH : makelist(tgd_simp(sum(sum(MH[a,b]*BH[k][a][b], b, 1, 4), a, 1, 4)), k, 1, 8)$
check("z1 = w/2: A = 0, the Kahler stress has type (1,1)", every(lambda([e], is(e = 0)), AH))$
jH : kahler_current(emH, JH)$
j2H : tgd_simp(sum(sum(emb_get(emH, 'g)[a,b]*jH[a]*jH[b], b, 1, 4), a, 1, 4))$
check("z1 = w/2: j is neither zero nor light-like", is(j2H # 0))$
check("z1 = w/2: J.J is not constant", is(diff(kahler_invariant(emb_get(emH, 'g), JH), xx) # 0))$
/* holomorphy scan: the CP_2 functions are inputs, the form of the principle stays open */
depends([au, bu], uu)$
check("scan: z1 = a(u) + i b(u) is a massless extremal with J = 0", report_is(rep_holo(au + %i*bu, 0), true, true, true))$
check("scan: z1 = w^2/4 is minimal only", report_is(rep_holo(lc_w^2/4, 0), false, false, true))$
check("scan: z1 = w, z2 = w^2 is minimal only", report_is(rep_holo(lc_w, lc_w^2), false, false, true))$
check("scan: z1 = a(u) w is minimal only", report_is(rep_holo(au*lc_w, 0), false, false, true))$
check("scan: z1 = a(u) + w/3 is minimal only", report_is(rep_holo(au + lc_w/3, 0), false, false, true))$
check("control: a non-holomorphic z1 = conj(w)^2 + w is not minimal",
      not rhs(third(rep_holo(conjugate(lc_w)^2 + lc_w, 0))))$
/* CP_2-type extremals: the surface is CP_2 and M^4 follows a light-like curve */
xiP : [pa, pb, pc, pd]$
declare([pa, pb, pc, pd], real)$
cp2Surf(m) := append(m, xiP)$
rep_cp2type(m) := extremal_report(emb_setup(HGs, H_X, cp2Surf(m), xiP), HJs, trigsimp)$
check("CP_2-type, light-like geodesic and harmonic s: both parts vanish",
      report_is(rep_cp2type([pa, pa, 0, 0]), false, true, true))$
check("CP_2-type, curved light-like curve: Kahler part vanishes, volume part does not",
      report_is(rep_cp2type([pa, cos(pa), sin(pa), 0]), false, true, false))$
check("CP_2-type, light-like geodesic along Re(z1^2): both parts vanish",
      report_is(rep_cp2type([pa^2 - pb^2, pa^2 - pb^2, 0, 0]), false, true, true))$
check("control: CP_2-type along the non-harmonic s = pa^2 is not minimal",
      report_is(rep_cp2type([pa^2, pa^2, 0, 0]), false, true, false))$
/* Lagrangian: J = 0 on the real slice of CP_2 */
rep_lag(s) := extremal_report(emb_setup(HGs, H_X, append(lc_m4, s), lc_chart), HJs, trigsimp)$
check("Lagrangian: geodesic x1 = tan(x) is a vacuum extremal and minimal",
      report_is(rep_lag([tan(xx), 0, 0, 0]), true, true, true))$
check("control: x1 = x is a vacuum extremal but not minimal",
      report_is(rep_lag([xx, 0, 0, 0]), true, true, false))$
/* Pitkanen's ansatz (4.3, item 5) in explicit form: two-dimensional Lagrangian CP_2
   projection, conformal into the unit sphere, with a 4-D M^4 projection */
check("Lagrangian: stereographic f = w is a vacuum extremal and minimal",
      report_is(rep_lag(lagrangian_stereo(lc_w)), true, true, true))$
emLag : emb_setup(HGs, H_X, append(lc_m4, lagrangian_stereo(lc_w)), lc_chart)$
check("Lagrangian: f = w has mean curvature H^k = 0",
      every(lambda([e], is(e = 0)), mean_curvature(emLag, second_fundamental_form(emLag))))$
check("Lagrangian: f = w has a non-flat induced metric",
      is(tgd_simp(emb_get(emLag, 'g)[3,3] + 1) # 0))$
check("Lagrangian: f = w has sqrt|g| = (1 + 4/(1+|w|^2)^2)/2, area excess 4 pi",
      is(tgd_simp(-determinant(emb_get(emLag, 'g)) - ((1 + 4/(1+xx^2+yy^2)^2)/2)^2) = 0)
      and is(integrate(4/(1+rho^2)^2*2*%pi*rho, rho, 0, inf) = 4*%pi))$
check("Lagrangian: stereographic f = w/2 is a vacuum extremal and minimal",
      report_is(rep_lag(lagrangian_stereo(lc_w/2)), true, true, true))$
check("Lagrangian: stereographic f = w^2 is a vacuum extremal and minimal",
      report_is(rep_lag(lagrangian_stereo(lc_w^2)), true, true, true))$
check("control: anti-conformal mix f = w + conj(w)/2 is a vacuum extremal but not minimal",
      report_is(rep_lag(lagrangian_stereo(lc_w + conjugate(lc_w)/2)), true, true, false))$
/* holography = holomorphy in Pitkanen's form: every root of f1 = f2 = 0 is one sheet */
none(p, l) := not some(p, l)$
sheets : hh_sheets(xi1^2 - hhw^2/4, xi2 - xi1^2, lc_w)$
check("H-H: xi1^2 = w^2/4, xi2 = xi1^2 has two sheets", is(length(sheets) = 2))$
check("H-H: both sheets are minimal",
      every(lambda([s], rhs(third(rep_holo(s[1], s[2])))), sheets))$
sheets : hh_sheets(hhw*xi1 - 1, xi2, lc_w)$
check("H-H: the rational root xi1 = 1/w is minimal",
      rhs(third(rep_holo(sheets[1][1], sheets[1][2]))))$
/* flat H-J structure: Lorentz force.  The Kahler part cannot vanish on a holomorphic
   surface, the transverse current is the obstruction (Pitkanen's j x B = 0 test) */
check("flat H-J, z1 = w/2: the Lorentz force j^a J_ab does not vanish",
      is(lorentz_force(emH, JH) # [0, 0, 0, 0]))$
check("flat H-J, z1 = w/2: j lies in the transverse plane",
      is(jH[3] # 0))$
/* with the transverse form eps dx ^ dy of M^4 added to J, the Kahler part is exactly
   (eps - 1)^2 times the one without it */
HJM : H_kahler_m4t()$
EK0 : tgd_field_equations(emH, HJs, 1, 0)$
EKe : tgd_field_equations(emH, HJs + eps*HJM, 1, 0)$
check("flat H-J, z1 = w/2: E(J + eps J(M^4)) = (eps - 1)^2 E(J)",
      every(lambda([e], is(e = 0)), map(tgd_simp, EKe - (eps - 1)^2*EK0)))$
/* so the holomorphic surfaces become Kahler extremals in two ways, as one J = J(CP_2) + J(M^4)
   with coefficient 1, or as a separate action with the relative coefficient -1 */
flat_E(z1, z2, HJ) := tgd_field_equations(emb_setup(HGs, H_X, holo_surface(lc_m4, z1, z2), lc_chart), HJ, 1, 0)$
holoScan : [[lc_w/2, 0], [lc_w^2/4, 0], [lc_w, lc_w^2], [uu + lc_w/3, 0], [uu*lc_w/3, 0]]$
check("flat H-J: J alone never gives a Kahler extremal on the scan",
      none(lambda([z], every(lambda([e], is(e = 0)), flat_E(z[1], z[2], HJs))), holoScan))$
check("flat H-J: the sum J + J(M^4) gives a Kahler extremal on the whole scan",
      every(lambda([z], every(lambda([e], is(e = 0)), flat_E(z[1], z[2], HJs + HJM))), holoScan))$
check("flat H-J: separate actions E(J) - E(J(M^4)) cancel on the whole scan",
      every(lambda([z], every(lambda([e], is(e = 0)),
        map(tgd_simp, flat_E(z[1], z[2], HJs) - flat_E(z[1], z[2], HJM)))), holoScan))$
JT : induced_kahler_form(HJs + HJM, H_X, emb_get(emH, 'h), lc_chart)$
check("flat H-J, z1 = w/2 with the sum: j = 0 and J.J is constant",
      is(kahler_current(emH, JT) = [0, 0, 0, 0]) and is(kahler_invariant(emb_get(emH, 'g), JT) = 2))$
/* spherical H-J structure: the Kahler part vanishes when the pullback of the Fubini-Study
   metric is proportional to the metric of S^2.  Calabi rigidity leaves the line and the conic */
SHs : sj_H_metric()$
sj_em(z1, z2) := emb_setup(SHs, sj_H_X, sj_surface(z1, z2), sj_X)$
sj_rep(z1, z2) := extremal_report(sj_em(z1, z2), HJs)$
check("spherical H-J, line xi1 = w: J # 0, both parts vanish",
      report_is(sj_rep(sj_w, 0), false, true, true))$
check("spherical H-J, Moebius xi1 = (1+w)/(1-w): both parts vanish",
      report_is(sj_rep((1 + sj_w)/(1 - sj_w), 0), false, true, true))$
check("spherical H-J, conic xi1 = sqrt(2) w, xi2 = w^2: both parts vanish",
      report_is(sj_rep(sqrt(2)*sj_w, sj_w^2), false, true, true))$
check("spherical H-J, xi1 = w^2: minimal only",
      report_is(sj_rep(sj_w^2, 0), false, false, true))$
check("spherical H-J, xi1 = 2 w: minimal only",
      report_is(sj_rep(2*sj_w, 0), false, false, true))$
emSL : sj_em(sj_w, 0)$
JSL : induced_kahler_form(HJs, sj_H_X, emb_get(emSL, 'h), sj_X)$
check("spherical H-J, line: j = 0 and the Lorentz force vanishes",
      is(kahler_current(emSL, JSL) = [0, 0, 0, 0]) and is(lorentz_force(emSL, JSL) = [0, 0, 0, 0]))$
check("spherical H-J, line: g_ww = -(r^2 + 1/4) rho, the CP_1 radius adds to r",
      is(tgd_simp(emb_get(emSL, 'g)[3,3] + (hr^2 + 1/4)*sj_rho) = 0))$
check("spherical H-J, line: J.J depends on r",
      is(diff(kahler_invariant(emb_get(emSL, 'g), JSL), hr) # 0))$
emSC : sj_em(sqrt(2)*sj_w, sj_w^2)$
check("spherical H-J, conic: g_ww = -(r^2 + 1/2) rho, twice the line",
      is(tgd_simp(emb_get(emSC, 'g)[3,3] + (hr^2 + 1/2)*sj_rho) = 0))$
/* u dependence on the spherical structure: the light rays expand, so a function of u is
   not a wave, box f(t - r) = 2 f'/r.  The same surfaces are minimal on the flat structure. */
sj_lc_rep(z1, z2) := extremal_report(emb_setup(SHs, sj_H_X, sj_lc_surface(z1, z2), sj_chart), HJs)$
rphase : (1 + %i*uu)/(1 - %i*uu)$
check("spherical H-J, u,v chart: the line without u stays minimal",
      rhs(third(sj_lc_rep(sj_w, 0))))$
check("spherical H-J: the rotated line xi1 = e^{i a(u)} w is not minimal",
      not rhs(third(sj_lc_rep(rphase*sj_w, 0))))$
check("spherical H-J: xi1 = u + w is not minimal", not rhs(third(sj_lc_rep(uu + sj_w, 0))))$
check("spherical H-J: xi1 = u is not minimal", not rhs(third(sj_lc_rep(uu, 0))))$
check("flat H-J: the rotated line xi1 = e^{i a(u)} w is minimal",
      rhs(third(rep_holo(rphase*lc_w, 0))))$
check("flat H-J: xi1 = u is minimal", rhs(third(rep_holo(uu, 0))))$
waveF : (ht - hr)^3$
check("M^4: box f(t - r) = 2 f'/r on the spherical wave f = (t - r)^3",
      is(ratsimp(diff(waveF, ht, 2) - diff(waveF, hr, 2) - 2/hr*diff(waveF, hr)
                 - 2/hr*3*(ht - hr)^2) = 0))$
/* spherically symmetric: M^1 x a catenoid in R^3 x a geodesic of CP_2 */
depends(chi, r)$
sxi : [t, r, th, ph]$
emS : emb_setup(sph_H_metric(), sph_H_X, [t, r, th, ph, tan(chi), 0, 0, 0], sxi)$
partsS : extremal_parts(emS, H_kahler())$
check("spherical: the Kahler part vanishes for every chi(r)",
      every(lambda([e], is(trigsimp(tgd_simp(e)) = 0)), partsS[1]))$
/* the volume part reduces to the catenoid equation d(r^2 chi'/sqrt(1 + chi'^2))/dr = 0,
   that is chi'' = -2 chi' (1 + chi'^2)/r */
pchi : diff(chi, r)$
sV(q2) := map(lambda([e], trigsimp(tgd_simp(subst(diff(chi, r, 2) = q2, e)))), partsS[2])$
check("spherical: the volume part vanishes on the catenoid equation",
      every(lambda([e], is(e = 0)), sV(-2*pchi*(1 + pchi^2)/r)))$
check("control: a straight chi'' = 0 with chi' # 0 is not minimal",
      not every(lambda([e], is(e = 0)), sV(0)))$
ode : diff(r^2*diff(chi, r)/sqrt(1 + diff(chi, r)^2), r)$
catC : subst([diff(chi, r, 2) = diff(cc/sqrt(r^4 - cc^2), r), diff(chi, r) = cc/sqrt(r^4 - cc^2)], ode)$
check("spherical: chi' = C/sqrt(r^4 - C^2) solves the catenoid equation",
      is(radcan(ev(catC, nouns)) = 0))$
