/* ================================================================
   TGD Geometry Lab -- tgd/characteristics.mac
   Characteristic analysis of the field equations (Step 7.5), in the spirit
   of calcev in LanyonScripts: write the system as  d_t U + A d_x U = 0  and
   read the characteristic speeds from the eigenvalues of A.

   The field equations are second order.  Their principal part at a point is
       P^{ab}_{ij} d_a d_b u^j,    P^{ab}_{ij} = d^2 L / d(d_a h^i) d(d_b h^j),
   computed directly from L(h, dh) by perturbing the Jacobian of the embedding.
   u are the embedding coordinates listed in fields (the others are the gauge
   choice).  With U = (d_t u, d_x u),
       A = [ [ 2 inv(P^tt) P^tx, inv(P^tt) P^xx ], [ -1, 0 ] ],
   which needs an invertible P^tt.  Equivalently det(s^2 P^tt - 2 s P^tx + P^xx) = 0
   for a front moving with speed s = dx/dt.
   Requires tgd/field-equations.mac.
   ================================================================ */

/* L at a point from the values of h and of the Jacobian; sg = sign of det g */
lagrangian_at(hv, Jc, HG, HJ, HX, cK, cV, sg) := block(
  [G : psubst(map("=", HX, hv), HG), W : psubst(map("=", HX, hv), HJ), g, Ji, gi, n],
  n : length(Jc[1]),
  g : transpose(Jc) . G . Jc, Ji : transpose(Jc) . W . Jc, gi : invert(g),
  (cK*sum(sum(sum(sum(gi[a,c]*gi[b,d]*Ji[a,b]*Ji[c,d], d,1,n), c,1,n), b,1,n), a,1,n) + cV)
    * sqrt(sg*determinant(g)))$

/* P[a][b] = matrix P^{ab}_{ij}, symmetrised in (a,b); dirs lists coordinate
   positions, pt fixes the point */
principal_blocks(HG, HJ, HX, Xemb, xi, pt, fields, dirs, cK, cV, sg) := block(
  [hv, J0, nf:length(fields), nd:length(dirs), H, Jp],
  hv : subst(pt, Xemb),
  J0 : subst(pt, jacobian_matrix(Xemb, xi)),
  H(i, a, j, b) := block([Jq : copymatrix(J0)],
    Jq[fields[i], dirs[a]] : Jq[fields[i], dirs[a]] + tgd_e1,
    Jq[fields[j], dirs[b]] : Jq[fields[j], dirs[b]] + tgd_e2,
    ratsimp(subst([tgd_e1 = 0, tgd_e2 = 0],
      diff(lagrangian_at(hv, Jq, HG, HJ, HX, cK, cV, sg), tgd_e1, 1, tgd_e2, 1)))),
  makelist(makelist(
    genmatrix(lambda([i,j], tgd_simp((H(i,a,j,b) + H(i,b,j,a))/2)), nf, nf),
    b, 1, nd), a, 1, nd))$

/* A of d_t U + A d_x U = 0 from the blocks P^tt, P^tx, P^xx */
quasilinear_matrix(Ptt, Ptx, Pxx) := block([n:length(Ptt), Pi, B, C, A],
  Pi : mat_inverse(Ptt),
  B : tgd_msimp(2*Pi . Ptx), C : tgd_msimp(Pi . Pxx),
  A : zeromatrix(2*n, 2*n),
  for i thru n do (
    for j thru n do (A[i,j] : B[i,j], A[i,n+j] : C[i,j]),
    A[n+i,i] : -1),
  A)$

/* characteristic polynomial in the speed s */
speed_polynomial(Ptt, Ptx, Pxx, s) := factor(determinant(s^2*Ptt - 2*s*Ptx + Pxx))$

/* eigenanalysis of a matrix with numeric entries:
   list of [speed, algebraic multiplicity, independent eigenvectors] */
characteristic_report(A) := block([r : eigenvalues(A), n : length(A)],
  makelist([r[1][i], r[2][i],
            n - rank(matrixmap(lambda([e], radcan(rectform(e))), A - r[1][i]*ident(n)))],
           i, 1, length(r[1])))$

/* degenerate: P^tt singular, the problem cannot be solved for d_t^2 u.
   hyperbolic: real speeds and a full set of eigenvectors.
   weakly_hyperbolic: real speeds, eigenvectors missing.
   complex: some speed is complex (elliptic behaviour). */
characteristic_type(Ptt, Ptx, Pxx) := block([rep],
  if is(tgd_simp(determinant(Ptt)) = 0) then return('degenerate),
  rep : characteristic_report(quasilinear_matrix(Ptt, Ptx, Pxx)),
  if not every(lambda([q], is(imagpart(rectform(q[1])) = 0)), rep) then 'complex
  else if every(lambda([q], is(q[2] = q[3])), rep) then 'hyperbolic
  else 'weakly_hyperbolic)$
