section("embedding in H = M^4 x CP_2")$
GH : H_metric()$
JH : H_kahler()$
xi : [t0, t1, t2, t3]$
check("H signature (1,7) at a point",
      is(metric_signature_at(GH, [x1=0,y1=0,x2=0,y2=0]) = [1,7,0]))$
/* canonical M^4 embedding with a fixed CP_2 point */
emb0 : [t0, t1, t2, t3, 0, 0, 0, 0]$
check("canonical M^4: induced metric = Minkowski",
      zero_matrix_p(induced_metric(GH, H_X, emb0, xi) - minkowski_metric()))$
check("canonical M^4: induced Kahler form = 0",
      zero_matrix_p(induced_kahler_form(JH, H_X, emb0, xi)))$
/* Massless-extremal type ansatz in light-cone parameters xi = (u, v, x, y),
   t = (u+v)/2, z = (v-u)/2  (so u = t - z).  CP_2 coordinates depend on u and on
   the transverse coordinate x only. */
xl : [uu, vv, xx, yy]$
depends([F1, F2], [uu, xx])$
emb1 : [(uu+vv)/2, xx, yy, (vv-uu)/2, F1, F2, 0, 0]$
gME : induced_metric(GH, H_X, emb1, xl)$
JME : induced_kahler_form(JH, H_X, emb1, xl)$
giME : mat_inverse(gME)$
check("ME: induced J is non-zero", not zero_matrix_p(JME))$
check("ME: J has only the (u,x) component", is(JME[1,3] # 0 and tgd_simp(JME[1,2]) = 0 and tgd_simp(JME[2,3]) = 0))$
check("ME: du stays light-like, g^{uu} = 0", is(giME[1,1] = 0))$
check("ME: J_ab J^ab = 0 (null Kahler field)", is(kahler_invariant(gME, JME) = 0))$
check("ME: instanton density J^J = 0", is(tgd_simp(instanton_density(JME)) = 0))$
/* pure u-dependence: induced metric has the flat determinant -1/4 */
depends([F3], [uu])$
g3 : induced_metric(GH, H_X, [(uu+vv)/2, xx, yy, (vv-uu)/2, F3, 0, 0, 0], xl)$
check("ME with u-dependence only: det g = -1/4 (as for M^4)", is(tgd_simp(determinant(g3)) = -1/4))$
/* Cosmic string X^2 x Y^2 : (t,z) free, Y^2 = CP_1 = {z2 = 0} a complex
   (homologically non-trivial) sphere in CP_2.  Parameters (t, z, a, b), z1 = a + i b. */
xs : [tt0, zz0, aa, bb]$
embCS : [tt0, 0, 0, zz0, aa, bb, 0, 0]$
gCS : induced_metric(GH, H_X, embCS, xs)$
JCS : induced_kahler_form(JH, H_X, embCS, xs)$
check("cosmic string: induced metric = M^2 (+) (-) S^2(r=1/2)",
      zero_matrix_p(gCS - diag_matrix(1, -1, -1/(1+aa^2+bb^2)^2, -1/(1+aa^2+bb^2)^2)))$
check("cosmic string: J_ab J^ab = 2 (constant magnetic Kahler field)",
      is(kahler_invariant(gCS, JCS) = 2))$
check("cosmic string: Kahler magnetic flux density J_ab = 1/(1+r^2)^2 da^db",
      is(tgd_simp(JCS[3,4] - 1/(1+aa^2+bb^2)^2) = 0))$
/* Manninen (2024, pp. 34-35, #34).  The contraction of J_ab with J^ab keeps the action
   invariant under coordinate transformations: the same surface in new, nonlinear parameters. */
ge_h : holo_surface(lc_m4, lc_w/2 + uu/3, 0)$
ge_x : [pp, qq, rr, ss]$
ge_m : [pp, qq*(1 + pp^2), rr + pp, ss + qq]$
ge_s : map("=", lc_chart, ge_m)$
ge_hn : subst(ge_s, ge_h)$
ge_g : induced_metric(GH, H_X, ge_h, lc_chart)$
ge_J : induced_kahler_form(JH, H_X, ge_h, lc_chart)$
ge_gn : induced_metric(GH, H_X, ge_hn, ge_x)$
ge_Jn : induced_kahler_form(JH, H_X, ge_hn, ge_x)$
check("reparametrised surface: g_ab = h_kl d_a h^k d_b h^l transforms as a tensor",
      zero_matrix_p(ge_gn - transform_02(ge_g, lc_chart, ge_x, ge_m)))$
check("reparametrised surface: J_ab = J_kl d_a h^k d_b h^l transforms as a tensor",
      zero_matrix_p(ge_Jn - transform_02(ge_J, lc_chart, ge_x, ge_m)))$
check("reparametrised surface: J.J is a non-constant scalar",
      block([s : kahler_invariant(ge_gn, ge_Jn)],
        is(diff(s, rr) # 0) and is(tgd_simp(s - subst(ge_s, kahler_invariant(ge_g, ge_J))) = 0)))$
check("reparametrised surface: det g changes by the squared Jacobian, 1 + p^2 is not constant",
      block([jc : determinant(jacobian_matrix(ge_m, ge_x))],
        is(diff(jc, pp) # 0)
        and is(tgd_simp(determinant(ge_gn) - jc^2*subst(ge_s, determinant(ge_g))) = 0)))$
/* the essay calls J_ab the induced Kahler metric.  It is a form: antisymmetric and closed, on a
   surface with a four-dimensional CP_2 projection, where d is computed from the components */
ge_I : [t0, t1, t2, t3, t0*t2/3 + t1/5, t0*t3/7 - t1^2/4, t1*t2/5 + t3/3, t0/5 + t2*t3/2]$
ge_JI : induced_kahler_form(JH, H_X, ge_I, xi)$
check("induced J_ab is antisymmetric and not zero",
      zero_matrix_p(ge_JI + transpose(ge_JI)) and not zero_matrix_p(ge_JI))$
check("induced J_ab is closed, dJ = 0 is the homogeneous Maxwell equation",
      form_zerop(dform(form_from_matrix(ge_JI), xi)))$
/* Manninen (2024, p. 36): on a light-like surface the induced metric has no inverse, which is
   why the term there is the metric-free Chern-Simons-Kahler action.  Here t = r on the
   spherical structure with a CP_2 line; t = 2 r is the control. */
ge_ll(tf) := induced_metric(sj_H_metric(), sj_H_X, append([tf, hr, sa, sb], cp2_real(sj_w, 0)), [hr, sa, sb])$
check("light-like 3-surface t = r: det g = 0 and rank 2, so g^ab does not exist",
      is(tgd_simp(determinant(ge_ll(hr))) = 0)
      and is(rank(subst([hr = 1, sa = 1/2, sb = 1/3], ge_ll(hr))) = 2))$
check("control: t = 2 r has det g # 0", is(tgd_simp(determinant(ge_ll(2*hr))) # 0))$
/* the essay writes sqrt(-g).  On a CP_2-type surface the signature is Euclidean, so det g > 0
   and the measure of S_K(CP_2) is sqrt|g|, which is what kahler_density uses */
ge_C : [pa, pa, 0, 0, pa, pb, pc, pd]$
ge_gC : induced_metric(GH, H_X, ge_C, [pa, pb, pc, pd])$
check("CP_2-type surface: det g = 1/(1+rho^2)^6 > 0 and J.J = 4",
      is(tgd_simp(determinant(ge_gC) - 1/(1 + pa^2 + pb^2 + pc^2 + pd^2)^6) = 0)
      and is(kahler_invariant(ge_gC, induced_kahler_form(JH, H_X, ge_C, [pa, pb, pc, pd])) = 4))$
/* S = S_K + S_V as a value: per unit area of M^2 the cosmic string carries the area pi of the
   sphere of radius 1/2, the volume part is c_V pi and the Kahler part 2 c_K pi */
assume(rc > 0)$
check("cosmic string: S_K + S_V per unit area of M^2 is pi (2 c_K + c_V)",
      is(ratsimp(2*%pi*integrate(rc*subst([aa = rc, bb = 0], tgd_density(gCS, JCS, cK, cV)), rc, 0, inf)
                 - %pi*(2*cK + cV)) = 0))$
/* Manninen (2024, p. 33): the imaginary unit of M^2 squares to +1, that of E^2 to -1 */
ge_K : block([m : zeromatrix(4, 4)], m[1,4] : 1, m[4,1] : -1, m[2,3] : 1, m[3,2] : -1, m)$
check("dt^dz + dx^dy: the structure g^-1 J squares to +1 on M^2 and to -1 on E^2",
      block([K : cp2_complex_structure(minkowski_metric(), ge_K)],
        zero_matrix_p(K . K - diag_matrix(1, -1, -1, 1))))$
