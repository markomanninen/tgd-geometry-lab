/* Hamilton-Jacobi structures of M^4 as orthogonal pairs of totally umbilic foliations.
   An H-J structure is a chart (u, v, w, wbar) with ds^2 = 2 A du dv - 2 B dw dwbar.  Since g_uu = g_vv = 0
   and g_ww = 0 identically, the leaves w = const (strings) and u, v = const (partons) are totally umbilic.
   With planar strings the partons are parallel surfaces of one umbilic parton: a plane, a sphere, an H^2
   or a paraboloid in a null hyperplane.  These give the flat, spherical, equidistant and horospheric
   structures.  With planar partons the strings are planes or de Sitter sheets.  Signature (+,-,-,-). */
section("tgd/hj-classification: H-J structures as umbilic foliations")$
hcM4 : diag_matrix(1, -1, -1, -1)$
hcX : [tt, xx, yy, zz]$
/* B^k_ab minus (1/2) g_ab g^cd B^k_cd for a 2-surface */
hc_traceless(em) := block([B : second_fundamental_form(em), g : emb_get(em, 'g), gi : emb_get(em, 'gi), N],
  N : length(B),
  flatten(makelist(makelist(makelist(
    B[k][a][b] - g[a,b]/2*sum(sum(gi[c,d]*B[k][c][d], d, 1, 2), c, 1, 2), b, 1, 2), a, 1, 2), k, 1, N)))$
hc_zero(l) := every(lambda([e], is(trigsimp(radcan(e)) = 0)), l)$
hc_H(em) := map(lambda([e], trigsimp(radcan(e))), mean_curvature(em, second_fundamental_form(em)))$
hc_norm(Hv) := trigsimp(radcan(Hv[1]^2 - Hv[2]^2 - Hv[3]^2 - Hv[4]^2))$
assume(hca > 0, hcr > 0)$
/* ---------- the umbilic partons of the planar-string structures ---------- */
check("sphere t = 0, r = R: umbilic parton with a space-like mean curvature",
      block([em : emb_setup(hcM4, hcX, [0, hcr*sin(hcth)*cos(hcph), hcr*sin(hcth)*sin(hcph), hcr*cos(hcth)], [hcth, hcph]), Hv],
        Hv : hc_H(em),
        hc_zero(hc_traceless(em)) and is(sign(hc_norm(Hv)) = neg)))$
check("H^2 of radius a in (t, y, z) at x = 0: umbilic parton with a time-like mean curvature",
      block([em : emb_setup(hcM4, hcX, hca*[cosh(hcp), 0, sinh(hcp)*cos(hcf), sinh(hcp)*sin(hcf)], [hcp, hcf]), Hv],
        Hv : hc_H(em),
        hc_zero(hc_traceless(em)) and is(sign(hc_norm(Hv)) = pos)))$
check("horosphere a = 1, t - z = 1: umbilic parton with a null, non-zero mean curvature",
      block([em : emb_setup(hcM4, hcX, [(2 + hcx^2 + hcy^2)/2, hcx, hcy, (hcx^2 + hcy^2)/2], [hcx, hcy]), Hv],
        Hv : hc_H(em),
        hc_zero(hc_traceless(em)) and is(hc_norm(Hv) = 0) and not every(lambda([e], is(e = 0)), Hv)))$
check("a generic parton such as a cylinder is not umbilic",
      not hc_zero(hc_traceless(emb_setup(hcM4, hcX, [0, hcr*cos(hcph), hcr*sin(hcph), hcz], [hcph, hcz]))))$
/* ---------- the de Sitter structure: planar partons, umbilic strings that are not minimal ---------- */
/* X = (rho sinh eta, rho cosh eta cos phi, rho cosh eta sin phi, z): the strings rho, z = const are de Sitter
   sheets of M^3, the partons eta, phi = const are (rho, z) half-planes */
hcdS : [hcrho*sinh(hceta), hcrho*cosh(hceta)*cos(hcphi), hcrho*cosh(hceta)*sin(hcphi), hcz]$
assume(hcrho > 0)$
check("de Sitter structure: g = diag(-1, -1, rho^2, -rho^2 cosh(eta)^2) in (rho, z, eta, phi), block diagonal",
      block([em : emb_setup(hcM4, hcX, hcdS, [hcrho, hcz, hceta, hcphi])],
        zero_matrix_p(map(trigsimp, emb_get(em, 'g) - diag_matrix(-1, -1, hcrho^2, -hcrho^2*cosh(hceta)^2)))))$
check("de Sitter structure: u = gd(eta) - phi with gd' = 1/cosh is null, and w = rho + i z has (grad w)^2 = 0 but box w = -2/rho",
      block([gi : diag_matrix(-1, -1, 1/hcrho^2, -1/(hcrho^2*cosh(hceta)^2)), du, dw, sq],
        du : [0, 0, 1/cosh(hceta), -1],
        dw : [1, %i, 0, 0],
        sq : hcrho^2*cosh(hceta),
        is(trigsimp(du . gi . du) = 0) and is(ratsimp(dw . gi . dw) = 0)
        and is(ratsimp(diff(sq*gi[1,1], hcrho)/sq + 2/hcrho) = 0)))$
check("de Sitter structure: the string rho = 1, z = 0 is umbilic but not minimal",
      block([em : emb_setup(hcM4, hcX, subst([hcrho = 1, hcz = 0], hcdS), [hceta, hcphi])],
        hc_zero(hc_traceless(em)) and not every(lambda([e], is(e = 0)), hc_H(em))))$
check("de Sitter structure: the parton eta = phi = 0 is a plane, so it is minimal",
      every(lambda([e], is(e = 0)), hc_H(emb_setup(hcM4, hcX, subst([hceta = 0, hcphi = 0], hcdS), [hcrho, hcz]))))$
/* ---------- conformal invariance: the inversion of the flat structure ---------- */
hc_dot(f, g) := ratsimp(diff(f, tt)*diff(g, tt) - diff(f, xx)*diff(g, xx) - diff(f, yy)*diff(g, yy) - diff(f, zz)*diff(g, zz))$
hc_box(f) := ratsimp(diff(f, tt, 2) - diff(f, xx, 2) - diff(f, yy, 2) - diff(f, zz, 2))$
check("inversion m -> m/m^2 of the flat structure keeps all H-J conditions",
      block([q : tt^2 - xx^2 - yy^2 - zz^2, u, v, w, wb],
        u : (tt - zz)/q, v : (tt + zz)/q, w : (xx + %i*yy)/q, wb : (xx - %i*yy)/q,
        every(lambda([e], is(ratsimp(e) = 0)),
              [hc_dot(u, u), hc_dot(v, v), hc_dot(w, w), hc_dot(u, w), hc_dot(u, wb), hc_dot(v, w), hc_dot(v, wb)])
        and is(ratsimp(hc_dot(u, v)) # 0) and is(ratsimp(hc_dot(w, wb)) # 0)))$
check("inversion of the flat structure: the image of the string x = 1, y = 0 is umbilic and not a plane",
      block([q : hct^2 - 1 - hcz^2, em],
        em : emb_setup(hcM4, hcX, [hct/q, 1/q, 0, hcz/q], [hct, hcz]),
        hc_zero(hc_traceless(em)) and not every(lambda([e], is(e = 0)), hc_H(em))))$
check("inversion of the flat structure: the image of the parton t = 1, z = 0 is umbilic and not a plane",
      block([q : 1 - hcx^2 - hcy^2, em],
        em : emb_setup(hcM4, hcX, [1/q, hcx/q, hcy/q, 0], [hcx, hcy]),
        hc_zero(hc_traceless(em)) and not every(lambda([e], is(e = 0)), hc_H(em))))$
/* ---------- conformal models: products of constant curvature 2-spaces ---------- */
/* a 2-D metric e^(2 f) du dv has curvature proportional to e^(-2 f) d_u d_v f */
check("horospheric: du dv - v^2 dw dwbar = v^2 (du dv/v^2 - dw dwbar), and du dv/v^2 is flat",
      is(diff(-log(hcv), hcu, 1, hcv, 1) = 0))$
check("spherical: dt^2 - dr^2 - r^2 dOmega^2 = r^2 (AdS_2 - S^2), the 2-D part (dt^2 - dr^2)/r^2 has constant curvature",
      block([f : -log((hcv - hcu)/2)], is(ratsimp(exp(-2*f)*diff(f, hcu, 1, hcv, 1)) = -1/4)))$
check("equidistant: d tau^2 - dx^2 - tau^2 dH^2 = tau^2 (dS_2 - H^2), the 2-D part (d tau^2 - dx^2)/tau^2 has constant curvature",
      block([f : -log((hcu + hcv)/2)], is(ratsimp(exp(-2*f)*diff(f, hcu, 1, hcv, 1)) = 1/4)))$
/* Umbilic leaves make g a doubly twisted product, conformal to dx1^2 - dx2^2 - e^(2 f) (dy1^2 + dy2^2).
   Its mixed Weyl components are d_x d_y f, so a conformally flat one has f = f1(x) + f2(y): a product of two
   2-D metrics, conformally flat only for opposite constant curvatures.  Up to the conformal group of M^4
   (Liouville) the H-J structures are E^{1,1} x E^2, AdS_2 x S^2 and dS_2 x H^2. */
depends(hcf2, [hx1, hx2, hy1, hy2])$
block([X : [hx1, hx2, hy1, hy2], g, gi, Rl, Ric, Rs, C],
  g : diag_matrix(1, -1, -exp(2*hcf2), -exp(2*hcf2)), gi : invert(g),
  Rl : riemann_lower(g, riemann(christoffel(g, X), X)),
  Ric : ricci(riemann(christoffel(g, X), X)),
  Rs : scalar_curvature(g, Ric),
  C : lambda([a, b, c, d], ratsimp(Rl[a][b][c][d]
        - (g[a,c]*Ric[b,d] - g[a,d]*Ric[b,c] - g[b,c]*Ric[a,d] + g[b,d]*Ric[a,c])/2
        + Rs*(g[a,c]*g[b,d] - g[a,d]*g[b,c])/6)),
  hcWeyl : [C(1,2,1,3) - diff(hcf2, hx2, 1, hy1, 1)/2, C(1,2,2,3) - diff(hcf2, hx1, 1, hy1, 1)/2,
            C(1,2,1,4) - diff(hcf2, hx2, 1, hy2, 1)/2, C(1,2,2,4) - diff(hcf2, hx1, 1, hy2, 1)/2])$
check("twisted 2+2 product: the mixed Weyl components C_1213, C_1223, C_1214, C_1224 are d_x d_y f / 2",
      every(lambda([e], is(ratsimp(e) = 0)), hcWeyl))$
remove(hcf2, dependency)$
/* ---------- the causal diamond with tips 0 and (T, 0) ---------- */
check("CD: on t^2 - r^2 = a^2 and (T - t)^2 - r^2 = b^2 the time is t = (T^2 + a^2 - b^2)/(2 T), so partons on both are spheres",
      is(ratsimp(((hcT - tt)^2 - hcr^2) - (tt^2 - hcr^2) - (hcT^2 - 2*hcT*tt)) = 0))$
/* ---------- which light coordinate a holomorphic surface may depend on (Pitkanen 5.11.2026 evening) ---------- */
/* With mutually null gradients box F(q, w) = F_q box q + F_w box w.  Spherical: box(t -+ r) = +-2/r, so neither
   u nor v keeps F minimal.  Horospheric: u = t - z gives null hyperplanes with box u = 0, while the level sets of
   v = a^2/(t - z) are light cones with vertices on the null line t = z and box v = 4/(t - z). */
check("spherical: box(t - r) = 2/r and box(t + r) = -2/r, so only F(w) is minimal",
      block([r : sqrt(xx^2 + yy^2 + zz^2)],
        is(radcan(hc_box(tt - r) - 2/r) = 0) and is(radcan(hc_box(tt + r) + 2/r) = 0)))$
check("horospheric: box u = 0 but box v = 4/(t - z), and v w is not harmonic while u w is",
      block([u : tt - zz, v : (tt^2 - xx^2 - yy^2 - zz^2)/(tt - zz), w : (xx + %i*yy)/(tt - zz)],
        is(ratsimp(hc_box(u)) = 0) and is(ratsimp(hc_box(v) - 4/(tt - zz)) = 0)
        and is(ratsimp(hc_box(u*w)) = 0) and is(ratsimp(hc_box(v*w)) # 0)))$
check("spherical in Milne coordinates: the null curves da = +- a d rho give a e^(-+rho) = t -+ r",
      is(trigsimp(exponentialize(hca*cosh(hcrho) - hca*sinh(hcrho) - hca*exp(-hcrho))) = 0)
      and is(trigsimp(exponentialize(hca*cosh(hcrho) + hca*sinh(hcrho) - hca*exp(hcrho))) = 0))$
/* ---------- minimality in M^4 of partons on light cones and hyperboloids (Pitkanen 6.11.2026) ---------- */
/* Every leaf of an H-J structure is totally umbilic, B^n_ab = lambda_n g_ab, so a minimal leaf has B = 0 and is a
   plane.  A surface on the hyperboloid a = const has H(M^4) = H(H^3) + (2/a) N, since H^3 is umbilic in M^4. */
hc_dot4(p, q) := p[1]*q[1] - p[2]*q[2] - p[3]*q[3] - p[4]*q[4]$
assume(hct0 > hcr)$
block([em, Hv, a0, rh, N, nu, l, n],
  em : emb_setup(hcM4, hcX, [hct0, hcr*sin(hcth)*cos(hcph), hcr*sin(hcth)*sin(hcph), hcr*cos(hcth)], [hcth, hcph]),
  Hv : hc_H(em),
  a0 : sqrt(hct0^2 - hcr^2),
  rh : [sin(hcth)*cos(hcph), sin(hcth)*sin(hcph), cos(hcth)],
  N : append([hct0], hcr*rh)/a0, nu : append([hcr], hct0*rh)/a0,
  l : append([1], rh), n : append([1], -rh),
  hcSph : map(lambda([e], trigsimp(radcan(e))),
              [hc_dot4(Hv, Hv) + 4/hcr^2, hc_dot4(Hv, l) + 2/hcr, hc_dot4(Hv, n) - 2/hcr,
               hc_dot4(Hv, N) + 2/a0, hc_dot4(Hv, nu) + 2*(hct0/hcr)/a0]))$
check("round sphere t = t0, r = r0: H.H = -4/r0^2 and the null components are -+2/r0, so no light cone through it makes it minimal",
      every(lambda([e], is(e = 0)), rest(hcSph, -2)))$
check("round sphere on t^2 - r^2 = a^2: H.N = -2/a and H.nu = -2 coth(rho)/a with coth(rho) = t0/r0, both diverge as a -> 0",
      every(lambda([e], is(e = 0)), rest(hcSph, 3)))$
check("totally geodesic H^2 of H^3(a): H = -(2/a) N, so a surface that is minimal in H^3 has mean curvature 2/a in M^4",
      block([X : hca*[cosh(hcp), 0, sinh(hcp)*cos(hcf), sinh(hcp)*sin(hcf)], Hv],
        Hv : hc_H(emb_setup(hcM4, hcX, X, [hcp, hcf])),
        every(lambda([e], is(trigsimp(e) = 0)), Hv + 2*X/hca^2)))$
check("spherical: box((t - r)^2) = 4 (t - r)/r, so a function of u alone is not harmonic there",
      block([r : sqrt(xx^2 + yy^2 + zz^2)], is(radcan(hc_box((tt - r)^2) - 4*(tt - r)/r) = 0)))$
forget(hct0 > hcr)$
/* ---------- cuts of the light cone (Pitkanen 6.11.2026 morning) ---------- */
/* On the cone t = r a cut r = R(theta, phi) has the degenerate-free metric -R^2 dOmega^2: every cut is conformally
   a round sphere, but its area int R^2 dOmega depends on R, and the generator l = (1, n) is a normal along which
   the second fundamental form is R dOmega^2, so the expansion 2/R never vanishes. */
depends(hcRc, [hcth, hcph])$
block([nh, X, em, g, l, Bl],
  nh : [sin(hcth)*cos(hcph), sin(hcth)*sin(hcph), cos(hcth)],
  X : hcRc*append([1], nh), l : append([1], nh),
  em : emb_setup(hcM4, hcX, X, [hcth, hcph]), g : emb_get(em, 'g),
  Bl : genmatrix(lambda([a, b], hc_dot4(diff(diff(X, [hcth, hcph][a]), [hcth, hcph][b]), l)), 2, 2),
  hcCut : [zero_matrix_p(map(trigsimp, g + hcRc^2*matrix([1, 0], [0, sin(hcth)^2]))),
           every(lambda([e], is(trigsimp(e) = 0)), [hc_dot4(diff(X, hcth), l), hc_dot4(diff(X, hcph), l), hc_dot4(l, l)]),
           is(trigsimp(ratsimp(sum(sum(invert(g)[a, b]*Bl[a, b], a, 1, 2), b, 1, 2) + 2/hcRc)) = 0)])$
remove(hcRc, dependency)$
check("light-cone cut r = R(theta, phi): the induced metric is -R^2 dOmega^2 for every R, so all cuts are conformally round",
      hcCut[1])$
check("light-cone cut: the generator l is a null normal and g^ab l.B_ab = -2/R, so the expansion never vanishes",
      hcCut[2] and hcCut[3])$
check("cone area int R^2 dOmega: dR = 1 gives dA/de = 8 pi r0, dR = cos(theta) gives 0 and A = 4 pi r0^2 + 4 pi e^2/3",
      block([A : lambda([f], ratsimp(integrate(integrate(f^2*sin(hcth), hcth, 0, %pi), hcph, 0, 2*%pi)))],
        is(ratsimp(subst(hce = 0, diff(A(hcr + hce), hce)) - 8*%pi*hcr) = 0)
        and is(ratsimp(subst(hce = 0, diff(A(hcr + hce*cos(hcth)), hce))) = 0)
        and is(ratsimp(A(hcr + hce*cos(hcth)) - 4*%pi*hcr^2 - 4*%pi*hce^2/3) = 0)))$
check("hyperboloid a in (r, theta, phi): g^rr and Gamma^r_thth = -r (a^2 + r^2)/a^2 diverge as a -> 0, g_rr Gamma^r_thth = -r stays",
      block([gH : matrix([hca^2/(hca^2 + hcr^2), 0, 0], [0, hcr^2, 0], [0, 0, hcr^2*sin(hcth)^2]), Gm],
        Gm : christoffel(gH, [hcr, hcth, hcph]),
        is(ratsimp(invert(gH)[1,1] - (hca^2 + hcr^2)/hca^2) = 0)
        and is(ratsimp(Gm[1][2][2] + hcr*(hca^2 + hcr^2)/hca^2) = 0)
        and is(ratsimp(gH[1,1]*Gm[1][2][2] + hcr) = 0)
        and is(limit(invert(gH)[1,1], hca, 0, plus) = inf)))$
/* ---------- isometries of the light-cone boundary (Pitkanen 8.11.2026) ---------- */
/* With z = rho e^(i phi) the boundary t = r has the metric -r^2 4 dz dzbar/(1 + |z|^2)^2.  For holomorphic f the map
   z -> f(z), r -> r (1 + |f|^2)/((1 + |z|^2) |f'|) preserves it, while an f that depends on r adds dr terms.  A cut
   r = R is the image of the sphere r = r0 exactly when its Gaussian curvature (1 - Lap log R)/R^2 equals 1/r0^2.
   On the whole sphere these cuts are the boosted spheres r0/(cosh b - sinh b cos th), which lie on hyperplanes. */
hc_nst(p, f) := [2*p*cos(f), 2*p*sin(f), p^2 - 1]/(1 + p^2)$
hc_met3(X, q) := block([J : genmatrix(lambda([i, j], diff(X[i], q[j])), 4, 3)],
  map(lambda([e], radcan(trigsimp(ratsimp(e)))), transpose(J) . hcM4 . J))$
hc_Kcut(R) := block([q : [hcth, hcph], g, G], g : R^2*matrix([1, 0], [0, sin(hcth)^2]), G : christoffel(g, q),
  trigsimp(ratsimp(scalar_curvature(g, ricci(riemann(G, q)))/2)))$
assume(hcsr > 0, hclam > 0, hcb > 0)$
block([q : [hcr, hcsr, hcsp], g0, zk],
  g0 : hc_met3(hcr*append([1], hc_nst(hcsr, hcsp)), q),
  zk : lambda([k], hcr*(1 + hcsr^(2*k))/((1 + hcsr^2)*k*hcsr^(k - 1))*append([1], hc_nst(hcsr^k, k*hcsp))),
  hcIso : [zero_matrix_p(hc_met3(zk(2), q) - g0), zero_matrix_p(hc_met3(zk(3), q) - g0),
           zero_matrix_p(hc_met3(hcr*(1 + hclam^2*hcsr^2)/((1 + hcsr^2)*hclam)*append([1], hc_nst(hclam*hcsr, hcsp)), q) - g0),
           not zero_matrix_p(hc_met3(hcr*append([1], hc_nst(hcsr, hcsp + hcc*hcr)), q) - g0)])$
check("light-cone boundary: z -> f(z), r -> r (1 + |f|^2)/((1 + |z|^2) |f'|) is an isometry for f = z^2, z^3 and lam z",
      hcIso[1] and hcIso[2] and hcIso[3])$
check("light-cone boundary: the r-dependent rotation z -> exp(i c r) z adds dr terms, so an isometry has f independent of r",
      hcIso[4])$
check("the boost f = lam z maps the sphere r = r0 onto the cut of the hyperplane t cosh b - z sinh b = r0, lam = e^b",
      block([X : hcr*(1 + hclam^2*hcsr^2)/((1 + hcsr^2)*hclam)*append([1], hc_nst(hclam*hcsr, hcsp))],
        is(radcan((hclam + 1/hclam)/2*X[1] - (hclam - 1/hclam)/2*X[4] - hcr) = 0)))$
depends(hcRc, [hcth, hcph])$
check("cut r = R(theta, phi): the Gaussian curvature of R^2 dOmega^2 is (1 - Lap log R)/R^2",
      block([lap : lambda([f], diff(sin(hcth)*diff(f, hcth), hcth)/sin(hcth) + diff(f, hcph, 2)/sin(hcth)^2)],
        is(trigsimp(ratsimp(hc_Kcut(hcRc) - (1 - lap(log(hcRc)))/hcRc^2)) = 0)))$
remove(hcRc, dependency)$
check("boosted cut r0/(cosh b - sinh b cos th): curvature 1/r0^2 and area 4 pi r0^2, the same as the round sphere",
      block([Rb : hcr/(cosh(hcb) - sinh(hcb)*cos(hcth))],
        is(trigsimp(ratsimp(hc_Kcut(Rb)*hcr^2)) = 1)
        and is(trigsimp(ratsimp(integrate(2*%pi*Rb^2*sin(hcth), hcth, 0, %pi) - 4*%pi*hcr^2)) = 0)))$
check("cut r0 (1 + e h): r0^2 K = 1 - e (Lap h + 2 h) to first order, so h = 1 gives -2, l = 1 gives 0, P_2 gives 4 P_2",
      block([lin : lambda([h], ratsimp(trigsimp(subst(hce = 0, diff(hc_Kcut(hcr*(1 + hce*h))*hcr^2, hce)))))],
        is(lin(1) = -2) and is(lin(cos(hcth)) = 0) and is(lin(sin(hcth)*cos(hcph)) = 0)
        and is(ratsimp(lin((3*cos(hcth)^2 - 1)/2) - 2*(3*cos(hcth)^2 - 1)) = 0)))$
forget(hcsr > 0, hclam > 0, hcb > 0)$
/* ---------- the convention g^rr = 0 and null hyperplanes (Pitkanen 8.11.2026) ---------- */
/* A degenerate metric q with radical l has a torsion-free q-compatible connection only if L_l q = 0 (Kupeli's
   stationarity).  On the cone q = r^2 dOmega^2 has L_l q = (2/r) q, so the Christoffel symbols built with the
   pseudo-inverse g^rr = 0 do not preserve q, while the rescaled q~ = dOmega^2 is stationary and they do.  An
   inversion centred on the cone maps it onto a null hyperplane with an r-independent metric, and every cut
   t + z = V(x, y) of a null hyperplane t - z = u0 is flat with the null mean curvature (Lap V) l. */
hc_nabla(gq, gpi, q) := block([G],
  G : makelist(makelist(makelist(sum(gpi[a,d]*(diff(gq[d,c], q[b]) + diff(gq[b,d], q[c]) - diff(gq[b,c], q[d])), d, 1, 3)/2,
       c, 1, 3), b, 1, 3), a, 1, 3),
  makelist(makelist(makelist(trigsimp(diff(gq[b,c], q[a]) - sum(G[d][a][b]*gq[d,c] + G[d][a][c]*gq[b,d], d, 1, 3)),
       c, 1, 3), b, 1, 3), a, 1, 3))$
check("light-cone boundary q = r^2 dOmega^2: L_l q = (2/r) q, and g^rr = 0 Christoffels give nabla_th q_r,th = -r",
      block([gq : matrix([0, 0, 0], [0, hcr^2, 0], [0, 0, hcr^2*sin(hcth)^2]), D],
        D : hc_nabla(gq, matrix([0, 0, 0], [0, 1/hcr^2, 0], [0, 0, 1/(hcr^2*sin(hcth)^2)]), [hcr, hcth, hcph]),
        zero_matrix_p(diff(gq, hcr) - 2/hcr*gq) and is(D[2][1][2] = -hcr)))$
check("rescaled dOmega^2: its Lie derivative along l vanishes and the g^rr = 0 Christoffels preserve it",
      block([gq : matrix([0, 0, 0], [0, 1, 0], [0, 0, sin(hcth)^2])],
        zero_matrix_p(diff(gq, hcr)) and
        every(lambda([e], is(e = 0)), flatten(hc_nabla(gq, matrix([0, 0, 0], [0, 1, 0], [0, 0, 1/sin(hcth)^2]), [hcr, hcth, hcph])))))$
check("inversion centred at p = (1,0,0,1) on the cone: image on the null hyperplane y.p = -1/2, metric -dOmega^2/(4 (1 - cos th)^2)",
      block([X : hcr*[1, sin(hcth)*cos(hcph), sin(hcth)*sin(hcph), cos(hcth)], p : [1, 0, 0, 1], Y, J3, gY],
        Y : (X - p)/hc_dot4(X - p, X - p),
        J3 : genmatrix(lambda([i, j], diff(Y[i], [hcr, hcth, hcph][j])), 4, 3),
        gY : map(lambda([e], trigsimp(ratsimp(e*4*(1 - cos(hcth))^2))), transpose(J3) . hcM4 . J3),
        is(trigsimp(ratsimp(hc_dot4(Y, p))) = -1/2)
        and every(lambda([e], is(trigsimp(e) = 0)), flatten(args(gY - matrix([0, 0, 0], [0, -1, 0], [0, 0, -sin(hcth)^2]))))))$
depends(hcV, [hcx, hcy])$
block([X : [(hcV + hcu0)/2, hcx, hcy, (hcV - hcu0)/2], em, Hv],
  em : emb_setup(hcM4, hcX, X, [hcx, hcy]),
  Hv : map(ratsimp, mean_curvature(em, second_fundamental_form(em))),
  hcNull : [zero_matrix_p(emb_get(em, 'g) + ident(2)),
            every(lambda([e], is(e = 0)), ratsimp(Hv - Hv[1]*[1, 0, 0, 1])),
            is(ratsimp(hc_dot4(Hv, Hv)) = 0), is(ratsimp(hc_dot4(Hv, [1, 0, 0, 1])) = 0),
            is(ratsimp(Hv[1]^2 - (diff(hcV, hcx, 2) + diff(hcV, hcy, 2))^2/4) = 0)])$
remove(hcV, dependency)$
check("null hyperplane t - z = u0, cut t + z = V(x, y): metric -(dx^2 + dy^2) for every V, so moving along l keeps the area",
      hcNull[1])$
check("null hyperplane cut: H is null and along l with |H^t| = |Lap V|/2, H.l = 0, so the cut is minimal iff V is harmonic",
      hcNull[2] and hcNull[3] and hcNull[4] and hcNull[5])$
check("horospheric parton u = u0, v = v0: t + z = (u0 v0 + x^2 + y^2)/u0, a cut of the null hyperplane t - z = u0",
      block([t : ((hcu0*hcv0 + hcx^2 + hcy^2)/hcu0 + hcu0)/2, z : ((hcu0*hcv0 + hcx^2 + hcy^2)/hcu0 - hcu0)/2],
        is(ratsimp(t - z - hcu0) = 0) and is(ratsimp((t^2 - hcx^2 - hcy^2 - z^2)/(t - z) - hcv0) = 0)))$
forget(hca > 0, hcr > 0, hcrho > 0)$
