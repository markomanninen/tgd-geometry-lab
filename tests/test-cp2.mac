section("spaces/cp2 (Fubini-Study)")$
G : cp2_metric()$
W : cp2_kahler_matrix()$
Jc : cp2_complex_structure(G, W)$
check("metric symmetric", zero_matrix_p(G - transpose(G)))$
check("det g = 1/(1+rho^2)^6 (TGD normalisation)", is(tgd_simp(determinant(G) - 1/(1+cp2_rho2)^6) = 0))$
check("metric positive definite at a sample point",
      is(metric_signature_at(G, [x1=1/3, y1=-2, x2=1/2, y2=1]) = [4,0,0]))$
check("inverse metric", zero_matrix_p(mat_inverse(G) . G - ident(4)))$
check("J^2 = -1", zero_matrix_p(Jc . Jc + ident(4)))$
check("J is g-orthogonal: J^T g J = g", zero_matrix_p(transpose(Jc) . G . Jc - G))$
omega : form_from_matrix(W)$
check("d omega = 0 (Kahler)", form_zerop(dform(omega, cp2_X)))$
check("omega^omega/2 = volume form",
      is(tgd_simp(top_coef(wedge(omega, omega))/2 - 1/(1+cp2_rho2)^3) = 0))$
Gam : christoffel(G, cp2_X)$
check("Christoffel symbols symmetric", christoffel_symmetric_p(Gam))$
check("nabla g = 0", nested_zero_p(cov_deriv_02(G, Gam, cp2_X)))$
check("nabla J = 0 (Kahler)", nested_zero_p(cov_deriv_11(Jc, Gam, cp2_X)))$
Riem : riemann(Gam, cp2_X)$
Rl : riemann_lower(G, Riem)$
Ric : ricci(Riem)$
check("Riemann algebraic symmetries", riemann_symmetries_p(Rl))$
check("first Bianchi identity", bianchi1_p(Riem))$
check("Kahler-Einstein: Ric = 6 g", zero_matrix_p(Ric - 6*G))$
check("scalar curvature R = 24", is(scalar_curvature(G, Ric) = 24))$
check("contracted Bianchi: div(Einstein tensor) = 0",
      nested_zero_p(einstein_divergence(G, Ric, Gam, cp2_X)))$
e1 : [1,0,0,0]$
Je1 : list_matrix_entries(Jc . transpose(matrix(e1)))$
check("holomorphic sectional curvature = 4 (general point)",
      is(sectional_curvature(G, Rl, e1, Je1) = 4))$
check("totally real plane (x1,x2) at origin has K = 1",
      is(subst([x1=0,y1=0,x2=0,y2=0], sectional_curvature(G, Rl, [1,0,0,0], [0,0,1,0])) = 1))$
/* chart transition Z0 -> Z1 */
Gc1 : transform_02(G, cp2_X, cp2_W, cp2_chart1_to_chart0())$
check("chart transition Z0<->Z1 preserves the FS metric",
      zero_matrix_p(Gc1 - cp2_metric_in_chart(cp2_W)))$
/* all three charts (#8): generic map from homogeneous coordinates */
check("cp2_chart_map(1,0) = cp2_chart1_to_chart0()",
      is(tgd_simp(cp2_chart_map(1,0) - cp2_chart1_to_chart0()) = [0,0,0,0]))$
check("cp2_chart2_to_chart0() = cp2_chart_map(2,0)",
      is(tgd_simp(cp2_chart2_to_chart0() - cp2_chart_map(2,0)) = [0,0,0,0]))$
for pr in [[0,1],[1,0],[0,2],[2,0],[1,2],[2,1]] do block([a:pr[1], b:pr[2], Xa, Xb, Mab],
  Xa : cp2_chart_coords(a), Xb : cp2_chart_coords(b), Mab : cp2_chart_map(a, b),
  check(sconcat("chart ", a, " -> ", b, ": FS metric preserved"),
        zero_matrix_p(transform_02(cp2_metric_in_chart(Xb), Xb, Xa, Mab) - cp2_metric_in_chart(Xa))),
  check(sconcat("chart ", a, " -> ", b, ": Kahler form preserved"),
        zero_matrix_p(transform_02(subst(map("=", cp2_X, Xb), W), Xb, Xa, Mab)
                      - subst(map("=", cp2_X, Xa), W))))$
/* cocycle condition on the triple overlap */
check("cocycle: phi(0<-1) o phi(1<-2) = phi(0<-2)",
      is(tgd_simp(subst(map("=", cp2_W, cp2_chart_map(2,1)), cp2_chart_map(1,0))
                  - cp2_chart_map(2,0)) = [0,0,0,0]))$
/* curvature invariants recomputed from the transformed metric of each chart */
for a in [1,2] do block([Xa:cp2_chart_coords(a), Gt, Rt, Rct],
  Gt : transform_02(G, cp2_X, Xa, cp2_chart_map(a,0)),
  Rt : riemann(christoffel(Gt, Xa), Xa),
  Rct : ricci(Rt),
  check(sconcat("chart ", a, ": Ric = 6 g from the transformed metric"), zero_matrix_p(Rct - 6*Gt)),
  check(sconcat("chart ", a, ": R = 24 from the transformed metric"), is(scalar_curvature(Gt, Rct) = 24)))$
/* TGD reference values (Pitkanen): CP_2 type vacuum extremal */
check("J_kl J^kl = 4 on CP_2", is(kahler_invariant(G, W) = 4))$
check("sqrt(det g) = 1/(1+rho^2)^3", is(tgd_simp(determinant(G) - (1/(1+cp2_rho2)^3)^2) = 0))$
/* integral over the chart (complement has measure zero); S^3 area = 2 pi^2,
   integrand J.J sqrt(g) = 4/(1+r^2)^3 by the two checks above */
IKJ : 2*%pi^2 * integrate(rr^3 * kahler_invariant(G, W)/(1+rr^2)^3, rr, 0, inf)$
check("Vol(CP_2) = pi^2/2", is(2*%pi^2*integrate(rr^3/(1+rr^2)^3, rr, 0, inf) = %pi^2/2))$
check("Kahler action of CP_2: S_K = pi/(8 alpha_K) with L_K = J.J sqrt(g)/(4 g_K^2)",
      is(ratsimp(subst(gK2 = 4*%pi*alphaK, IKJ/(4*gK2)) - %pi/(8*alphaK)) = 0))$
/* general radius: Ric is scale invariant, so Ric = 6 g / R^2 */
block([cp2_R2 : Rsq],
  GR : cp2_metric(),
  RicR : ricci(riemann(christoffel(GR, cp2_X), cp2_X)),
  check("Ric = 6 g / R^2 for symbolic R^2", zero_matrix_p(RicR - 6*GR/Rsq)))$
