section("Clifford algebra (Prodanov clifford package)")$
if stringp(clifford_path) then (
  tgd_add_clifford_path(clifford_path),
  load(sconcat(clifford_path, "/clifford.mac")),
  clifford(cg, 4),
  check("Euclidean Cl(4,0): e_i e_j + e_j e_i = 2 delta_ij",
        every(lambda([p], is(cg[p[1]] . cg[p[2]] + cg[p[2]] . cg[p[1]]
                             = (if p[1] = p[2] then 2 else 0))),
              create_list([i,j], i, 1, 4, j, 1, 4))),
  clifford(cs, 1, 3),
  check("Cl(1,3): g_a g_b + g_b g_a = 2 eta_ab",
        every(lambda([p], is(cs[p[1]] . cs[p[2]] + cs[p[2]] . cs[p[1]]
                             = 2*minkowski_metric()[p[1], p[2]])),
              create_list([i,j], i, 1, 4, j, 1, 4))),
  /* local generators on CP_2: gamma^m = e_a^m e_a.  Coefficients stay outside
     the dot product, which treats undeclared expressions as non-commuting. */
  clifford(cg, 4),   /* clifford() replaces the rules of the previous algebra */
  block([Ei : frame_inverse(cp2_vielbein()), gi : mat_inverse(cp2_metric())],
    check("CP_2: {gamma^m, gamma^n} = 2 g^{mn}, Prodanov generators",
          every(lambda([p], is(tgd_simp(sum(sum(Ei[p[1],a]*Ei[p[2],b]*(cg[a] . cg[b] + cg[b] . cg[a]),
                                                b, 1, 4), a, 1, 4)
                                        - 2*gi[p[1], p[2]]) = 0)),
                create_list([i,j], i, 1, 4, j, 1, 4)))))
else print("  SKIP  clifford tests (CLIFFORD_PATH not set)")$
