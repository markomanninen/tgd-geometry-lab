section("forms")$
Xq : [q1,q2,q3,q4]$
depends(F0, Xq)$
depends([A1,A2,A3,A4], Xq)$
check("dx1^dx2 = -dx2^dx1", form_zerop(form_add(wedge(dx(1),dx(2)), wedge(dx(2),dx(1)))))$
check("dx1^dx1 = 0", form_zerop(wedge(dx(1),dx(1))))$
check("d^2 = 0 on a generic 0-form", form_zerop(dform(dform(form0(F0), Xq), Xq)))$
Aform : [[A1,[1]],[A2,[2]],[A3,[3]],[A4,[4]]]$
check("d^2 = 0 on a generic 1-form", form_zerop(dform(dform(Aform, Xq), Xq)))$
/* d(A f) = dA f - A ^ df  for a 1-form A and 0-form f */
check("graded Leibniz rule",
      form_zerop(form_sub(dform(wedge(Aform, form0(F0)), Xq),
                          form_sub(wedge(dform(Aform, Xq), form0(F0)),
                                   wedge(Aform, dform(form0(F0), Xq))))))$
check("matrix <-> 2-form round trip",
      zero_matrix_p(form_to_matrix(form_from_matrix(matrix([0,a,b],[-a,0,c],[-b,-c,0])), 3)
                    - matrix([0,a,b],[-a,0,c],[-b,-c,0])))$
check("Euclidean R^4: *dx1 = dx2^dx3^dx4", is(hodge(dx(1), ident(4)) = [[1,[2,3,4]]]))$
check("Euclidean R^4: ** = +1 on 2-forms",
      is(hodge(hodge(wedge(dx(1),dx(2)), ident(4)), ident(4)) = wedge(dx(1),dx(2))))$
check("Minkowski: ** = -1 on 2-forms",
      is(hodge(hodge(wedge(dx(1),dx(2)), minkowski_metric()), minkowski_metric())
         = form_scale(-1, wedge(dx(1),dx(2)))))$
/* pullback and integrals (#13) */
XR2 : [xx, yy]$
XR3 : [xx, yy, zz]$
check("pullback commutes with d",
      form_zerop(form_sub(form_pullback(dform([[yy^2*zz,[1]],[xx*zz,[2]]], XR3), XR3, [uu, vv, uu*vv], [uu, vv]),
                          dform(form_pullback([[yy^2*zz,[1]],[xx*zz,[2]]], XR3, [uu, vv, uu*vv], [uu, vv]), [uu, vv]))))$
check("pullback commutes with wedge",
      form_zerop(form_sub(form_pullback(wedge([[zz,[1]]], [[xx,[2]]]), XR3, [uu, vv, uu*vv], [uu, vv]),
                          wedge(form_pullback([[zz,[1]]], XR3, [uu, vv, uu*vv], [uu, vv]),
                                form_pullback([[xx,[2]]], XR3, [uu, vv, uu*vv], [uu, vv])))))$
/* Stokes on the unit square, boundary counter-clockwise */
form1S : [[xx^2*yy, [1]], [xx*yy^3, [2]]]$
edges : [[[ss, 0], [ss, 0, 1]], [[1, ss], [ss, 0, 1]], [[1-ss, 1], [ss, 0, 1]], [[0, 1-ss], [ss, 0, 1]]]$
bS : apply("+", map(lambda([e], form_integral(form1S, XR2, e[1], [e[2]])), edges))$
check("Stokes: unit square", is(bS = form_integral(dform(form1S, XR2), XR2, [xx, yy], [[xx,0,1],[yy,0,1]])))$
/* Stokes on a curved surface: paraboloid z = 1 - r^2 over the unit disc */
aP : [[-yy*zz, [1]], [xx, [2]], [yy^2, [3]]]$
assume(rp > 0)$
paraS : [rp*cos(ph), rp*sin(ph), 1-rp^2]$
circle : [cos(ph), sin(ph), 0]$
inP : trigsimp(top_coef(form_pullback(dform(aP, XR3), XR3, paraS, [rp, ph])))$
check("Stokes: paraboloid over the unit disc",
      is(ratsimp(integrate(integrate(inP, rp, 0, 1), ph, 0, 2*%pi)
                 - form_integral(aP, XR3, circle, [[ph, 0, 2*%pi]])) = 0))$
/* Kahler flux: homology of complex curves in CP_2 */
omegaF : form_from_matrix(cp2_kahler_matrix())$
Apot : makelist([cp2_kahler_1form()[m], [m]], m, 1, 4)$
fluxP(emb) := block([c : trigsimp(top_coef(form_pullback(omegaF, cp2_X, emb, [rp, ph])))],
  integrate(c, ph, 0, 2*%pi))$
assume(rq > 0)$
check("CP_1 disc: Stokes with the Kahler potential",
      is(ratsimp(integrate(fluxP([rp*cos(ph), rp*sin(ph), 0, 0]), rp, 0, rq)
                 - form_integral(Apot, cp2_X, [rq*cos(ph), rq*sin(ph), 0, 0], [[ph, 0, 2*%pi]])) = 0))$
check("flux through CP_1 = pi", is(integrate(fluxP([rp*cos(ph), rp*sin(ph), 0, 0]), rp, 0, inf) = %pi))$
check("flux through the conic z2 = z1^2 = 2 pi (degree 2)",
      is(ratsimp(integrate(fluxP([rp*cos(ph), rp*sin(ph), rp^2*cos(2*ph), rp^2*sin(2*ph)]), rp, 0, inf)) = 2*%pi))$
/* Manninen (2024, p. 36, #34): the instanton term is a total divergence that reduces to the
   Chern-Simons-Kahler term on the boundary.  With dA = J, J ^ J = d(A ^ J) on the chart, and
   Stokes holds on the ball |z| < q.  Hopf angles (p1, a, p2) carry the outward orientation. */
AJF : wedge(Apot, omegaF)$
JJF : wedge(omegaF, omegaF)$
check("instanton density: J ^ J = d(A ^ J) on CP_2", form_zerop(form_sub(dform(AJF, cp2_X), JJF)))$
hopf : [rq*cos(ha)*cos(hp1), rq*cos(ha)*sin(hp1), rq*sin(ha)*cos(hp2), rq*sin(ha)*sin(hp2)]$
csB : trigsimp(top_coef(form_pullback(AJF, cp2_X, hopf, [hp1, ha, hp2])))$
csI : integrate(integrate(integrate(csB, hp1, 0, 2*%pi), ha, 0, %pi/2), hp2, 0, 2*%pi)$
inB : 2*%pi^2*integrate(rp^3*2/(1+rp^2)^3, rp, 0, rq)$
check("Stokes: int J ^ J over the ball = Chern-Simons term of the 3-sphere, pi^2 q^4/(1+q^2)^2",
      is(ratsimp(csI - inB) = 0) and is(ratsimp(csI - %pi^2*rq^4/(1+rq^2)^2) = 0))$
/* the integrand 2/(1+r^2)^3 of inB is the coefficient of J ^ J, checked here on the chart */
check("int J ^ J over CP_2 = pi^2 = (flux through CP_1)^2, the generator squares to 1",
      is(tgd_simp(top_coef(JJF) - 2/(1+cp2_rho2)^3) = 0)
      and is(limit(inB, rq, inf) = %pi^2)
      and is(integrate(fluxP([rp*cos(ph), rp*sin(ph), 0, 0]), rp, 0, inf)^2 = %pi^2))$
